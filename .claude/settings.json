{
  "permissions": {
    "allow": [
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(./gradlew projects:*)",
      "Bash(./gradlew tasks:*)",
      "Bash(./gradlew dependencies:*)",
      "Bash(./gradlew dependencyInsight:*)",
      "Bash(./gradlew lintCheck:*)",
      "Bash(./gradlew check:*)",
      "Bash(./gradlew checkApiContracts:*)",
      "Bash(./gradlew test:*)",
      "Bash(./gradlew build:*)"
    ],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/deny-git-no-verify.sh\""
          }
        ]
      }
    ]
  }
}
