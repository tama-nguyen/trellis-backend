# Course module: UI read model. Owned by trellis-learning-content/; exported with the rest of the schema to
# contracts/graphql/schema.graphqls by :trellis-app:exportApiContracts.

extend type Query {
  "One course by code (CO-XXXX-XXXX-XXXX). One the caller may not see is a NOT_FOUND error, like a missing one."
  course(code: ID!): Course
  "Newest first. Pass nextCursor as `after` for the next page; same cursor format as GET /api/courses."
  courses(first: Int = 20, after: String, status: CourseStatus, query: String): CoursePage!
}

enum CourseStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

type Course {
  code: ID!
  name: String!
  description: String!
  status: CourseStatus!
  "Optimistic-lock version; the REST ETag."
  version: Int!
  createdAt: DateTime!
  updatedAt: DateTime!
  activatedAt: DateTime
  archivedAt: DateTime
}

"A list row: a course without its long fields."
type CourseSummary {
  code: ID!
  name: String!
  status: CourseStatus!
  createdAt: DateTime!
  activatedAt: DateTime
}

type CoursePage {
  items: [CourseSummary!]!
  nextCursor: String
  hasNext: Boolean!
}
