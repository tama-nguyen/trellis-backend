    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "5.107.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "next": "15.5.29",
    "next-intl": "4.15.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@graphql-codegen/cli": "7.4.6",
