# Root of the Lombok config tree: nothing above this directory is consulted.
config.stopBubbling = true

# Mark generated members with @lombok.Generated so JaCoCo leaves them out of coverage; otherwise an
# @Data class drags the numbers around without anyone writing a line.
lombok.addLombokGeneratedAnnotation = true

# @Data and @Value are blunt: they generate equals, hashCode and toString whether or not they make
# sense for the type. Use a record, or the specific annotation you mean.
lombok.data.flagUsage = ERROR
lombok.value.flagUsage = ERROR

# Field injection hides a bean's dependencies and cannot be constructed in a test.
lombok.nonNull.flagUsage = WARNING
