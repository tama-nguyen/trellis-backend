# One-shot `setup` container: same image as the backend, run in setup mode, then exit 0.
# Liquibase, then the Kafka topics (TRELLIS_SETUP_KAFKA_TOPICS=true) and S3 bucket
# (TRELLIS_SETUP_S3_BUCKET=true). The switch also keeps the relay, consumers and mail worker off.
SPRING_PROFILES_ACTIVE=dev
TRELLIS_SETUP_ENABLED=true
# A one-shot job serves no traffic.
SPRING_MAIN_WEB_APPLICATION_TYPE=none
OTEL_SERVICE_NAME=trellis-setup
