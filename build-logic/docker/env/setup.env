# One-shot `setup` container: same image as the backend, run in setup mode, then exit 0.
# TODO(wire): backend must implement the `setup` Spring profile: Liquibase update, create the Kafka
# topics listed in contracts/ (when TRELLIS_SETUP_KAFKA_TOPICS=true), create the S3 bucket (when
# TRELLIS_SETUP_S3_BUCKET=true), then exit with status 0 without starting the web server.
SPRING_PROFILES_ACTIVE=local,setup
SPRING_MAIN_WEB_APPLICATION_TYPE=none
SPRING_LIQUIBASE_ENABLED=true
OTEL_SERVICE_NAME=trellis-setup
