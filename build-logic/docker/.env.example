# Compose interpolation variables for docker/compose.yml. Every value here is the default already baked
# into compose.yml, so this file is documentation: copy it to docker/.env (gitignored) only to change
# something. scripts/dev/trellis-dev.sh writes nothing here; it exports per-slot values instead.
#
# Layering (later wins):
#   1. defaults inside compose.yml              ${VAR:-default}
#   2. docker/.env                              this file's copy, per machine, gitignored
#   3. shell environment                        e.g. exported by trellis-dev.sh or GitLab CI
# Container environment (not interpolation) is layered separately (docs/architecture/delivery.md,
# "Environment layering"): env/common.env -> env/<service>.env -> env/.env.local (gitignored, optional).

# --- Project / images ------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=trellis
TRELLIS_REGISTRY=trellis
TRELLIS_VERSION=local
# Per-service overrides, e.g. to run a released backend with a local web:
# TRELLIS_BACKEND_IMAGE=registry.gitlab.com/<group>/trellis/backend
# TRELLIS_BACKEND_VERSION=sha-1a2b3c4d
# TRELLIS_WEB_VERSION=main
# TRELLIS_WORKER_VERSION=main

# --- Host ports --------------------------------------------------------------------------------------
# Trellis range: 1xxxx. A dev slot N (trellis-dev.sh --slot N) adds N*1000 to every port.
TRELLIS_BIND=127.0.0.1
TRELLIS_PG_PORT=15432
TRELLIS_KAFKA_PORT=19092
TRELLIS_REDIS_PORT=16379
TRELLIS_MINIO_PORT=19000
TRELLIS_MINIO_CONSOLE_PORT=19001
TRELLIS_KEYCLOAK_PORT=18180
TRELLIS_BACKEND_PORT=18080
TRELLIS_BACKEND_MGMT_PORT=18081
TRELLIS_WEB_PORT=13000
TRELLIS_OTLP_GRPC_PORT=14317
TRELLIS_OTLP_HTTP_PORT=14318
TRELLIS_PROMETHEUS_PORT=19090
TRELLIS_GRAFANA_PORT=13300
TRELLIS_TEMPO_PORT=13200
TRELLIS_LOKI_PORT=13100
TRELLIS_BACKEND_DEBUG_PORT=15005
TRELLIS_WORKER_DEBUG_PORT=15678

# --- Dev-only credentials (never reuse outside a laptop) -------------------------------------------
TRELLIS_DB_PASSWORD=trellis
TRELLIS_MINIO_ROOT_PASSWORD=trellis-dev-secret
TRELLIS_KEYCLOAK_ADMIN_PASSWORD=admin
TRELLIS_GRAFANA_ADMIN_PASSWORD=admin

# --- Behaviour ---------------------------------------------------------------------------------------
# inmemory | kafka. Profiles full/debug run Kafka; trellis-dev.sh switches this to kafka for them.
TRELLIS_EVENTS_TRANSPORT=inmemory
TRELLIS_OTEL_ENABLED=false
