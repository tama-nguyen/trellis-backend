{
  "realm": "trellis",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "trellis-web",
      "name": "Trellis web (local)",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:13000/*"
      ],
      "webOrigins": [
        "http://localhost:13000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "trellis-cli",
      "name": "Trellis CLI and scripts (local only)",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "notification-reader",
        "description": "Reads published notifications for everyone (notification:read)."
      },
      {
        "name": "staff",
        "description": "Also reads STAFF notifications (notification:read, notification:read-staff)."
      },
      {
        "name": "notification-admin",
        "description": "Manages notifications (notification:read, notification:read-staff, notification:manage)."
      },
      {
        "name": "platform-admin",
        "description": "Operator: DLQ replay and read-model rebuild."
      }
    ]
  },
  "users": [
    {
      "username": "reader",
      "enabled": true,
      "email": "reader@example.test",
      "emailVerified": true,
      "firstName": "Reader",
      "lastName": "Sample",
      "realmRoles": [
        "notification-reader"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "reader-dev",
          "temporary": false
        }
      ]
    },
    {
      "username": "staff",
      "enabled": true,
      "email": "staff@example.test",
      "emailVerified": true,
      "firstName": "Staff",
      "lastName": "Sample",
      "realmRoles": [
        "staff"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "staff-dev",
          "temporary": false
        }
      ]
    },
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@example.test",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "Sample",
      "realmRoles": [
        "notification-admin",
        "platform-admin"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "admin-dev",
          "temporary": false
        }
      ]
    }
  ]
}
