# Container environment shared by every Trellis application container (backend, setup, worker, web).
# Committed, non-secret, dev defaults. Per-machine overrides go to docker/env/.env.local (gitignored,
# optional), which compose loads after the per-service file. Values that depend on compose
# interpolation (ports, passwords) live in compose.yml `environment:` instead.
TRELLIS_ENV=local
TZ=UTC
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local
